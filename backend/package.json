{
  "name": "backend",
  "private": true,
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:baseline": "prisma migrate resolve --applied 0_awal",
    "db:seed": "tsx prisma/seed.ts",
    "db:gambar": "node dist/scripts/migrateImages.js",
    "uji-beban:siapkan": "node dist/scripts/loadTestSeed.js",
    "uji-beban:jalankan": "node dist/scripts/loadTest.js",
    "uji-beban:hapus": "node dist/scripts/loadTestSeed.js --hapus"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "prisma": "^6.19.0",
    "tsx": "^4.19.0"
  }
}
