# Buat user database khusus aplikasi (jangan root). connection_limit mengatur jumlah koneksi Prisma.
DATABASE_URL="mysql://cbt:GANTI_PASSWORD_DB@127.0.0.1:3306/cbt_ujian?connection_limit=15&pool_timeout=20"

# Wajib diisi nilai acak. Buat dengan: openssl rand -hex 32
# Server menolak berjalan di mode produksi bila nilai ini kosong atau masih contoh.
JWT_SECRET=""

# Opsional: kunci enkripsi password siswa (yang dicetak di kartu peserta). Kosong = diturunkan dari JWT_SECRET,
# sehingga mengganti JWT_SECRET membuat password siswa tidak bisa ditampilkan lagi sampai dibuat ulang.
SANDI_SISWA_KEY=""

PORT=5000
# 127.0.0.1 bila ada reverse proxy (Caddy/Nginx) di mesin yang sama; 0.0.0.0 hanya untuk akses langsung di LAN.
HOST=127.0.0.1
NODE_ENV=production

# Jumlah reverse proxy di depan aplikasi. 1 untuk Caddy/Nginx di mesin yang sama.
# Kosongkan bila aplikasi diakses langsung tanpa proxy.
TRUST_PROXY=1

# Hanya diisi bila frontend disajikan dari origin lain. Pisahkan dengan koma.
CORS_ORIGIN=

# Folder penyimpanan gambar soal. Kosong = backend/uploads. Di server, pakai folder di luar kode dan ikutkan dalam cadangan.
UPLOAD_DIR=

# Host https yang boleh dipakai sebagai URL gambar soal, pisahkan dengan koma. Kosong = hanya gambar unggahan.
GAMBAR_HOST_DIIZINKAN=
