# Salin menjadi /etc/cbt/smp.env dan /etc/cbt/sma.env (chmod 640, pemilik root:cbt).
# Tiap sekolah memakai database, secret, dan port yang berbeda.
DATABASE_URL="mysql://cbt_smp:GANTI_PASSWORD_DB@127.0.0.1:3306/cbt_smp?connection_limit=10&pool_timeout=20"
JWT_SECRET="GANTI_DENGAN_HASIL_openssl_rand_-hex_32"
PORT=5001
HOST=127.0.0.1
TRUST_PROXY=1

# Dipakai sekali oleh "npm run db:seed" untuk mengisi identitas awal. logo: smpip atau smaip.
SEKOLAH_NAMA="SMPIP Baitussalam"
SEKOLAH_LOGO=smpip
